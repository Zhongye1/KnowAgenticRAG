{
  "name": "ars-web",
  "version": "0.7.2.beta1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "build": "tsc && NODE_ENV=production vite build --base=/",
    "preview": "vite preview",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "arch:check": "depcruise \"src/**/*.{ts,tsx}\" --config .dependency-cruiser.cjs",
    "lint:fsd": "steiger ./src",
    "test": "NODE_ENV=test vitest",
    "test:unit": "NODE_ENV=test vitest run",
    "api:snapshot": "node scripts/api-snapshot.mjs",
    "api:gen": "openapi-ts",
    "api:check": "node scripts/api-check.mjs",
    "generate": "plop",
    "storybook": "NODE_ENV=development storybook dev -p 6006",
    "build-storybook": "NODE_ENV=production storybook build"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-query-devtools": "^5.32.0",
    "@tanstack/react-table": "9.2.4",
    "@vscode/markdown-it-katex": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.1.1",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.38.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^12.0.2",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "nanoid": "^5.0.7",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^7.0.2",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.23.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@storybook/addon-a11y": "^8.0.10",
    "@storybook/addon-essentials": "^8.0.9",
    "@storybook/addon-links": "^8.0.9",
    "@storybook/react": "^8.0.9",
    "@storybook/react-vite": "^8.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^24.0.0",
    "oxc-transform-react": "^0.145.0",
    "oxlint": "^1.80.0",
    "plop": "^4.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "steiger": "^0.7.0",
    "storybook": "^8.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dev-inspector": "^2.2.7",
    "vitest": "^4.1.11"
  }
}
