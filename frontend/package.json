{
  "name": "ragf-react-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=/",
    "preview": "vite preview",
    "test": "vitest",
    "test-e2e": "pm2 start \"pnpm run-mock-server\" --name server && pnpm playwright test",
    "prepare": "husky",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "generate": "plop",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:check": "node scripts/generate-api.mjs --out /tmp/generated-api-check"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^3.3.4",
    "@ngneat/falso": "^7.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-query-devtools": "^5.32.0",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "dompurify": "^3.1.1",
    "eslint-plugin-check-file": "^2.8.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.38.0",
    "marked": "^12.0.2",
    "nanoid": "^5.0.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-query-auth": "^2.4.3",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^7.0.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.23.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.1",
    "@mswjs/http-middleware": "^0.10.1",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.0.10",
    "@storybook/addon-actions": "^8.0.9",
    "@storybook/addon-essentials": "^8.0.9",
    "@storybook/addon-links": "^8.0.9",
    "@storybook/node-logger": "^8.0.9",
    "@storybook/react": "^8.0.9",
    "@storybook/react-vite": "^8.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.17",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "husky": "^9.0.11",
    "jest-environment-jsdom": "^29.7.0",
    "js-cookie": "^3.0.5",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "msw": "^2.2.14",
    "oxlint": "^1.80.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.1.0",
    "plop": "^4.0.1",
    "pm2": "7.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "storybook": "^8.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vite-node": "^6.0.0",
    "vite-plugin-dev-inspector": "^2.2.7",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint src",
      "bash -c 'pnpm check-types'"
    ]
  }
}
