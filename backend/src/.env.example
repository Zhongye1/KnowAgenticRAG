# 后端应用环境变量（本地开发）
# 仅被后端进程读取（backend/src/core/config.py，ENV_FILE_PATH 固定指向本文件）
# 环境分层：
#   1. 根 .env            -> docker-compose 编排（容器账号/端口），账号必须与本文件一致
#   2. 本文件              -> 本地开发应用配置（localhost）
#   3. deploy/backend/docker-compose/.env.server -> Docker 部署应用配置（容器主机名）
# 修改账号类字段后运行：task env:check
ENVIRONMENT='dev'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='localhost'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='123456'
# 额外数据源
DATABASE_SOURCES='{}'
# Redis
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Token（本地开发可先用下方值；部署请使用 deploy/backend/docker-compose/.env.server 并更换为 secrets.token_urlsafe(32)）
TOKEN_SECRET_KEY='mPJp8cWk3lEDkUCulz8SwOoI8PWx9Ed_Nst9PomKtLY'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='localhost'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ App ] rag
# Milvus
MILVUS_HOST='localhost'
MILVUS_PORT=19530
MILVUS_USER='root'
MILVUS_PASSWORD='Milvus'
# MinIO
MINIO_HOST='localhost'
MINIO_PORT=9000
MINIO_ACCESS_KEY='minioadmin'
MINIO_SECRET_KEY='minioadmin123'
MINIO_KB_BUCKET='ragf-kb'
# ModelProvider（ragf-design D11/D16）
# 服务端默认 ModelScope 令牌：modelscope provider 未配 api_key/api_key_env 时回退到该 env；
# 留空 = 未配置，用户可在“模型供应商”管理中给 provider 行自行配 api_key
MODELSCOPE_ACCESS_TOKEN=''
MODELSCOPE_API_BASE='https://api-inference.modelscope.cn/v1/'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID=''
OAUTH2_GITHUB_CLIENT_SECRET=''
OAUTH2_GOOGLE_CLIENT_ID=''
OAUTH2_GOOGLE_CLIENT_SECRET=''
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
OAUTH2_STATE_REDIS_PREFIX='fba:oauth2:state:'
OAUTH2_STATE_EXPIRE_SECONDS=600
OAUTH2_GITHUB_REDIRECT_URI='http://localhost:8000/api/v1/oauth2/github/callback'
OAUTH2_GOOGLE_REDIRECT_URI='http://localhost:8000/api/v1/oauth2/google/callback'
OAUTH2_FRONTEND_LOGIN_REDIRECT_URI='http://localhost:5173/login'
OAUTH2_FRONTEND_BINDING_REDIRECT_URI='http://localhost:5173/binding'
EMAIL_HOST='localhost'
EMAIL_PORT=25
EMAIL_SSL=False
EMAIL_CAPTCHA_REDIS_PREFIX='fba:email:captcha:'
EMAIL_CAPTCHA_EXPIRE_SECONDS=300

# [ App ] kb（多租户知识库）
# 部署级域标识（默认 core，映射 Milvus default 库；其他值按同名 Database 隔离）
PLUGIN_NAMESPACE='core'
# 请求缺省知识库标识
KB_NAME='default'
# 是否允许请求覆盖域（仅测试环境开启）
ALLOW_NAMESPACE_OVERRIDE='false'
# Milvus 基础集合与向量维度
MILVUS_TEXT_COLLECTION='ragf_text'
MILVUS_VISUAL_COLLECTION='ragf_visual'
MILVUS_TEXT_VECTOR_DIM=1536
MILVUS_VISUAL_VECTOR_DIM=2048
# 启动时自动创建域对应的 Milvus Database
MILVUS_AUTO_CREATE_DB='true'
