# 后端应用环境变量（本地开发）
# 仅被后端进程读取（backend/src/core/config.py，ENV_FILE_PATH 固定指向本文件）
# 环境分层：
#   1. 根 .env            -> docker-compose 编排（容器账号/端口），账号必须与本文件一致
#   2. 本文件              -> 本地开发应用配置（localhost）
#   3. deploy/backend/docker-compose/.env.server -> Docker 部署应用配置（容器主机名）
# 修改账号类字段后运行：task env:check
ENVIRONMENT='dev'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='localhost'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='123456'
# 额外数据源
DATABASE_SOURCES='{}'
# Redis
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Token（本地开发可先用下方值；部署请使用 deploy/backend/docker-compose/.env.server 并更换为 secrets.token_urlsafe(32)）
TOKEN_SECRET_KEY='mPJp8cWk3lEDkUCulz8SwOoI8PWx9Ed_Nst9PomKtLY'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='localhost'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ App ] rag
# Milvus
MILVUS_HOST='localhost'
MILVUS_PORT=19530
MILVUS_USER='root'
MILVUS_PASSWORD='Milvus'
# MinIO
MINIO_HOST='localhost'
MINIO_PORT=9000
MINIO_ACCESS_KEY='minioadmin'
MINIO_SECRET_KEY='minioadmin123'
MINIO_KB_BUCKET='ragf-kb'
# ModelProvider（ragf-design D11/D16）：默认仅内置 dashscope（千问平台）；
# chat/自定义向量经「模型供应商」管理自建 openai 兼容 provider 行
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID=''
OAUTH2_GITHUB_CLIENT_SECRET=''
OAUTH2_GOOGLE_CLIENT_ID=''
OAUTH2_GOOGLE_CLIENT_SECRET=''
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
OAUTH2_STATE_REDIS_PREFIX='fba:oauth2:state:'
OAUTH2_STATE_EXPIRE_SECONDS=600
OAUTH2_GITHUB_REDIRECT_URI='http://localhost:8000/api/v1/oauth2/github/callback'
OAUTH2_GOOGLE_REDIRECT_URI='http://localhost:8000/api/v1/oauth2/google/callback'
OAUTH2_FRONTEND_LOGIN_REDIRECT_URI='http://localhost:5173/login'
OAUTH2_FRONTEND_BINDING_REDIRECT_URI='http://localhost:5173/binding'
EMAIL_HOST='localhost'
EMAIL_PORT=25
EMAIL_SSL=False
EMAIL_CAPTCHA_REDIS_PREFIX='fba:email:captcha:'
EMAIL_CAPTCHA_EXPIRE_SECONDS=300

# [ App ] kb（多租户知识库）
# 部署级域标识（默认 core，映射 Milvus default 库；其他值按同名 Database 隔离）
PLUGIN_NAMESPACE='core'
# 请求缺省知识库标识
KB_NAME='default'
# 是否允许请求覆盖域（仅测试环境开启）
ALLOW_NAMESPACE_OVERRIDE='false'
# Milvus 基础集合与向量维度
MILVUS_TEXT_COLLECTION='ragf_text'
MILVUS_VISUAL_COLLECTION='ragf_visual'
MILVUS_TEXT_VECTOR_DIM=1536
MILVUS_VISUAL_VECTOR_DIM=2048
# 启动时自动创建域对应的 Milvus Database
MILVUS_AUTO_CREATE_DB='true'

# [ App ] ragf chat 门面（agent-layer spec D23/M9：检索+生成 SSE 问答）
# 默认 chat 模型 spec（provider:model，type=chat 模型行）；留空 = 请求必须显式 model
RAGF_CHAT_MODEL_SPEC=''
RAGF_CHAT_HISTORY_ROUNDS=10
RAGF_CONTEXT_MAX_TOKENS=4096
RAGF_CHAT_TIMEOUT_SECONDS=120.0
RAGF_CHAT_DEFAULT_TEMPERATURE=0.3

# [ App ] ragf 检索默认（M11：filters / 多 KB 聚合的参数默认值）
RAGF_RETRIEVAL_RRF_K=60
# 重排默认走千问平台（dashscope:qwen3.7-text-rerank，SDK 通道）；本地的可选 modelscope:BAAI/bge-reranker-v2-m3
RAGF_RETRIEVAL_RERANK_SPEC='dashscope:qwen3.7-text-rerank'

# [ App ] ragf MCP（agent-layer spec：只读工具面 /mcp，多凭证鉴权见设计文档 D22/D31-D33）
# Codex/Claude Code（未上 Keycloak 前）经本地桥接进程 env 注入的 PAT；留空 = 未启用 PAT 通道
RAGF_MCP_PAT=''
# PAT 通道默认授权（读面工具集）；JWT 直通无 scp claim 时同此默认
RAGF_MCP_DEFAULT_SCOPES='rag:kb:list,rag:kb:search,rag:kb:read,rag:kb:chat'
# MCP HTTP 端点路径（D20：默认 /mcp；全局 JWT 中间件按此前缀白名单放行，鉴权由端点接管）
RAGF_MCP_HTTP_PATH='/mcp'
# tools/call 调用审计落库（mcp_call_log 表）；关掉可跳过落库
RAGF_MCP_LOG_ENABLED='true'
# /mcp 端点限流（按 租户+sub 计，依赖 Redis；本地无 Redis 时可置 false）
RAGF_MCP_RATE_LIMIT_ENABLED='true'
RAGF_MCP_RATE_LIMIT_PER_MINUTE=120

# [ App ] ragf 双管线摄取（docs/specs/2026-09-10-dual-pipeline-ingest-design.md）
# 路由模式（KB 级 routing_mode 列可逐库覆盖）：auto=格式+形态路由（默认）；
# text/visual/hybrid=强制管线（legacy 工厂链已删除，无兜底）
RAGF_ROUTING_MODE='auto'
# PDF 形态探测阈值：文本页占比 / 每页均字符数低于任一阈值 → scanned（visual 管线）
RAGF_PDF_PROBE_TEXT_PAGE_RATIO=0.2
RAGF_PDF_PROBE_AVG_CHARS_PER_PAGE=50
# Knowhere 引擎：api=官方 SDK 调自建 :5005 服务（默认，task dev 经 docker/knowhere/
# 栈自动拉起）；parser=knowhere-parse-sdk 进程内（P4）；off=关闭（文档路由期 fail-closed 报错）
RAGF_KNOWHERE_MODE='api'
# 本地开发（后端跑宿主机）用 localhost:5005；容器部署时 ragf_server/worker 加入
# knowhere-net 网络后改用 http://knowhere:5005
RAGF_KNOWHERE_BASE_URL='http://localhost:5005'
# 可选：仅 Knowhere 部署带鉴权网关时配置；自建容器留空。MinerU 凭据在 Knowhere 服务侧配置
RAGF_KNOWHERE_API_KEY=''
RAGF_KNOWHERE_POLL_TIMEOUT=1800.0
# Knowhere 产物开关（LLM/VLM 摘要按量计费，默认关闭）
RAGF_KNOWHERE_SUMMARY_IMAGE='false'
RAGF_KNOWHERE_SUMMARY_TABLE='false'
# PixelRAG 视觉管线（render→tiles→Qwen3-VL-Embedding 2048d → ragf_visual）
RAGF_PIXELRAG_TILE_HEIGHT=1024
RAGF_PIXELRAG_QUALITY=85
RAGF_PIXELRAG_PDF_DPI=150
# 视觉编码 provider：dashscope=百炼 API（免 GPU）；local=本地 HF 权重（需 torch）
RAGF_VISUAL_PROVIDER='dashscope'
RAGF_VISUAL_MODEL='qwen3-vl-embedding'
RAGF_VISUAL_DIM=2048
# 千问平台 token（文本向量 qwen3.7-text-embedding-flash / 重排 qwen3.7-text-rerank /
# 多模态向量 qwen3-vl-embedding，均经 dashscope SDK 调用）
DASHSCOPE_API_KEY=''
# 摄取限额（Knowhere 内部 MinerU 精提取上限；0=关闭对应项）
RAGF_INGEST_LIMITS_ENABLED='true'
RAGF_INGEST_MAX_FILE_BYTES=209715200
RAGF_INGEST_MAX_PDF_PAGES=200
# 队列路由（留空=沿用默认队列 celery；配套 compose worker 见 docker-compose.yml profile ragf-ingest）
RAGF_CELERY_KNOWHERE_QUEUE=''
RAGF_CELERY_VISUAL_QUEUE=''
# URL 摄取（spec D10；多租户产品默认关闭，部署显式开启）
RAGF_URL_INGEST_ENABLED='false'
# 出网白名单（域名后缀，逗号分隔；留空=允许全部公网，仍强制 SSRF 防护）
RAGF_URL_EGRESS_ALLOWLIST=''
RAGF_URL_TIMEOUT_SECONDS=30.0
RAGF_URL_MAX_REDIRECTS=3
