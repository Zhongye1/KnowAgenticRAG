# Env
ENVIRONMENT='prod'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='ragf_postgres'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='123456'
# 额外数据源
# DATABASE_SOURCES='{"read": "postgresql+asyncpg://user:password@host:5432/ragf"}'
DATABASE_SOURCES='{}'
# Redis
REDIS_HOST='ragf_redis'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='kt8sAEb4q88mWiisW5e5yroID49Mb5XfI7EyRGUOmas'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='ragf_rabbitmq'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ Plugin ] code_generator
CODE_GENERATOR_DOWNLOAD_ZIP_FILENAME='code_generator.zip'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# [ Plugin ] oauth2（部署将 your-domain 替换为实际域名）
OAUTH2_STATE_REDIS_PREFIX='fba:oauth2:state:'
OAUTH2_STATE_EXPIRE_SECONDS=600
OAUTH2_GITHUB_REDIRECT_URI='https://your-domain/api/v1/oauth2/github/callback'
OAUTH2_GOOGLE_REDIRECT_URI='https://your-domain/api/v1/oauth2/google/callback'
OAUTH2_FRONTEND_LOGIN_REDIRECT_URI='https://your-domain/login'
OAUTH2_FRONTEND_BINDING_REDIRECT_URI='https://your-domain/binding'
# [ Plugin ] email（SMTP 服务商配置）
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
EMAIL_HOST='smtp.example.com'
EMAIL_PORT=465
EMAIL_SSL=True
EMAIL_CAPTCHA_REDIS_PREFIX='fba:email:captcha:'
EMAIL_CAPTCHA_EXPIRE_SECONDS=300
GRAFANA_OTLP_GRPC_ENDPOINT='ragf_alloy:4317'
GRAFANA_PROMETHEUS_APP_NAME='ragf_server'
GRAFANA_CELERY_OTEL_SERVICE_NAME='ragf_celery_worker'
GRAFANA_METRICS_PATH='/metrics'
GRAFANA_PROMETHEUS_EXEMPLAR_TRACE_ID_KEY='TraceID'
