# Knowhere 自托管栈用户覆盖模板：cp .env.example .env 后按需填写。
# 只写需要覆盖的项（默认值见 env.defaults）；.env 已被 gitignore，勿提交真实 key。
#
# 解析凭据在 Knowhere 服务侧配置（ragf 的 RAGF_KNOWHERE_API_KEY 只是 Knowhere
# HTTP 层可选网关凭据，与此处无关）。全部留空时服务可启动，但解析会因缺
# LLM/OCR 凭据 fail——文档语义解析至少需要 MINERU_API_KEYS + 一个 LLM key。

# -----------------------------------------------------------------------------
# 解析与 LLM 凭据（按量计费，最小集）
# -----------------------------------------------------------------------------
# MinerU 精提取（PDF/文档 OCR 解析，必填——mineru.net 申请）
MINERU_API_KEYS=
# 阿里云百炼（Qwen LLM/VLM：层级标题/摘要/图像理解，解析质量依赖）
ALI_API_KEYS=
# DeepSeek（层级归并/规范化 LLM，可选；留空回退 ALI）
DS_KEY=
#GLM_API_KEY=

# -----------------------------------------------------------------------------
# 镜像版本（固定 digest/版本号以保证可复现，latest 便于跟进上游）
# ghcr.io 直连国内常超时，推荐在 .env 覆盖为阿里云 ACR 镜像源：
#   KNOWHERE_IMAGE=knowhere-registry.cn-shenzhen.cr.aliyuncs.com/knowhere/knowhere:latest
# -----------------------------------------------------------------------------
#KNOWHERE_IMAGE=ghcr.io/ontos-ai/knowhere:latest

# -----------------------------------------------------------------------------
# 宿主机端口（默认已错开 ragf 主 compose；仅冲突时调整）
# -----------------------------------------------------------------------------
#API_HOST_PORT=5005
#DASHBOARD_HOST_PORT=13000
#POSTGRES_HOST_PORT=15432
#REDIS_HOST_PORT=16379
#LOCALSTACK_HOST_PORT=4566
